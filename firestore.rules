rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Configuração da sessão — leitura pública, escrita só pelo painel
    match /config/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Estado do jogo — leitura pública, escrita livre (modo teste)
    match /game/{doc} {
      allow read, write: if true;
    }

    match /game2/{doc} {
      allow read, write: if true;
    }

    // Jogadores — leitura e escrita livres
    match /players/{doc} {
      allow read, write: if true;
    }

    match /players2/{doc} {
      allow read, write: if true;
    }

    // Respostas do quiz
    match /answers/{doc} {
      allow read, write: if true;
    }

    // Votos da fase 2
    match /votes2/{doc} {
      allow read, write: if true;
    }

    // Link do laboratório
    match /lab/{doc} {
      allow read, write: if true;
    }
  }
}
